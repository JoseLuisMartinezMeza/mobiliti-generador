			<script>
                function showMenu() {
                    $('#header .linha2, #header .linha1 .box-right .box-campo').fadeToggle();
                    $('body').toggleClass('menu-opened');
                }
               
                
                function showUser() {
                    $('#header .linha1 .box-right .box_01 .menu-usuario, .boxBtComuni, #liOutrosSites').fadeToggle();
                    $('.buttonUser').toggleClass('act');
                }
                
                
                function inicializarComponentes() {

                    $('.buttonUser').click(function () {
                        showUser();
                        return false;
                    });

                    $('.menu-button').click(function () {
                        showMenu();
                        return false;
                    });
                    
                    if ($(window).width() <= 960) {
                        $('#header .linha2 ul li').click(function(){
                            if($(this).hasClass('act')){
                                $('#header .linha2 ul li').removeClass('act');
                                $('#header .linha2 ul li .submenu').slideUp();
                            } else {
                                $('#header .linha2 ul li').removeClass('act');
                                $('#header .linha2 ul li .submenu').slideUp();
                                $(this).addClass('act');
                                $(this).next('#header .linha2 ul li .submenu').slideDown();
                            };
                        });
                    };
                }
                

                var prm = Sys.WebForms.PageRequestManager.getInstance();

                if (prm != null) {
                    prm.add_endRequest(function (sender, e) {
                        if (sender._postBackSettings.panelsToUpdate != null) {
                            inicializarComponentes();
                        }
                    });
                }

                /* Execução inicial */
                document.addEventListener("DOMContentLoaded", inicializarComponentes);

            
			</script>
