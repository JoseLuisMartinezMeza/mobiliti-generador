# ═══════════════════════════════════════════════════════════════
# Mobiliti SaaS Backend - Variables de Entorno
# ═══════════════════════════════════════════════════════════════
# Copia este archivo a .env.local y rellena los valores.
# NUNCA comitees archivos .env con secretos reales.
# ═══════════════════════════════════════════════════════════════

# Supabase (obligatorio)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (obligatorio - minimo 32 caracteres aleatorios)
JWT_SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria_32chars_min

# CORS (opcional - origenes permitidos separados por coma)
# Si no se configura, el backend permite todas las peticiones SIN credenciales
CORS_ORIGINS=https://tu-app.vercel.app,https://otro-dominio.com

# Entorno (opcional - default: production)
# En produccion oculta /docs y /redoc
ENV=production
