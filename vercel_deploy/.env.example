# ═══════════════════════════════════════════════════════════════
# Mobiliti SaaS Backend - Variables de Entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA comitees archivos .env con secretos reales.
# ═══════════════════════════════════════════════════════════════

# Supabase (obligatorio)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (obligatorio - minimo 32 caracteres aleatorios, maxima entropia)
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria_minimo_48_chars

# CORS (obligatorio - origenes permitidos separados por coma)
# NUNCA uses "*" con allow_credentials=True
# Ejemplo: https://tu-app.vercel.app,https://otro-dominio.com
CORS_ORIGINS=https://verceldeploy-pied.vercel.app

# Entorno (opcional - default: production)
# En produccion oculta /docs y /redoc
ENV=production

# Admin seed (solo para scripts de inicializacion)
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=TuContrasenaSegura123!
ADMIN_NOMBRE=Administrador
