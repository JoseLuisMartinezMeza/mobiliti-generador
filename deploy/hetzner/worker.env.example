# Copy to /etc/mobiliti-worker/worker.env on the Hetzner server.
# Keep this file out of git after filling real values.

SUPABASE_URL=https://hcdspekajlszcycecpml.supabase.co
SUPABASE_ANON_KEY=
MOBILITI_REST_SECRET=
QUOTE_STORAGE_BUCKET=quote-files
QUOTE_STORAGE_PROVIDER=supabase
# For production R2 artifact storage:
# QUOTE_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quote-files
# R2_REGION=auto

QUOTE_ENGINE=python
MAX_QUOTE_OUTPUT_MB=100
WORKER_POLL_SECONDS=10
WORKER_STALE_MINUTES=30
WORKER_ISOLATE_JOBS=1
WORKER_JOB_TIMEOUT_SECONDS=0
IMAGE_PROVIDER=pillow
# Keep quote generation available when an optional external image provider fails.
IMAGE_PROVIDER_STRICT=false
