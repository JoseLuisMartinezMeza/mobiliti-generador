# Copy to /etc/mobiliti-worker/worker.env on the Hetzner server.
# Keep this file out of git after filling real values.

SUPABASE_URL=https://hcdspekajlszcycecpml.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
MOBILITI_REST_SECRET=
QUOTE_STORAGE_BUCKET=quote-files
QUOTE_STORAGE_PROVIDER=supabase
# For production R2 artifact storage:
# QUOTE_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quote-files
# R2_REGION=auto

QUOTE_ENGINE=python
MAX_QUOTE_OUTPUT_MB=150
WORKER_POLL_SECONDS=10
WORKER_STALE_MINUTES=30
WORKER_ISOLATE_JOBS=1
WORKER_JOB_TIMEOUT_SECONDS=0
# Refresco directo del inventario oficial de Offiho; habilitar tras migrar/API; no usa SharePoint.
OFFIHO_SYNC_ENABLED=false
OFFIHO_SYNC_INTERVAL_SECONDS=3600

# Catalog synchronization stays disabled until the source migration has completed.
CATALOG_SYNC_ENABLED=false
CATALOG_ENABLED_SUPPLIERS=
CATALOG_SYNC_TIMEOUT_SECONDS=1800
CATALOG_ASSET_STORAGE_PROVIDER=supabase
CATALOG_ASSET_PUBLIC_BASE_URL=
# R2 exclusivo de catalog-assets; no reutilizar credenciales ni bucket de quote-files.
CATALOG_ASSET_R2_ACCOUNT_ID=
CATALOG_ASSET_R2_ENDPOINT_URL=
CATALOG_ASSET_R2_ACCESS_KEY_ID=
CATALOG_ASSET_R2_SECRET_ACCESS_KEY=
CATALOG_ASSET_R2_BUCKET=catalog-assets
CATALOG_ASSET_R2_REGION=auto
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CERT_PATH=/run/secrets/mobiliti-graph/client-cert.pem
MS_GRAPH_CERT_THUMBPRINT=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_DRIVE_NAME=
SHAREPOINT_CATALOG_ROOT=

IMAGE_PROVIDER=pillow
# Keep quote generation available when an optional external image provider fails.
IMAGE_PROVIDER_STRICT=false
